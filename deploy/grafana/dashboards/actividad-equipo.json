{
  "uid": "aw-central-equipo",
  "title": "Actividad del equipo",
  "tags": [
    "aw-central"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now/d",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "PCs activos ahora (últimos 15 min)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "aw-central"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "aw-central"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS activos FROM device WHERE last_seen_at > now() - interval '15 minutes'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "PCs que reportaron hoy",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "aw-central"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "aw-central"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS hoy FROM device WHERE last_seen_at::date = current_date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Horas activas promedio por PC (rango)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "aw-central"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "aw-central"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COALESCE(ROUND(AVG(h)::numeric, 2), 0) AS promedio FROM (\n  SELECT device_id, SUM(duration_s)/3600.0 AS h FROM event\n  WHERE bucket_id LIKE 'aw-watcher-afk%' AND data->>'status' = 'not-afk' AND $__timeFilter(start_ts) GROUP BY device_id) t"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Total PCs registrados",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "aw-central"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "aw-central"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS total FROM device"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 4
    },
    {
      "type": "barchart",
      "title": "Actividades más frecuentes (horas por aplicación)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "aw-central"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "aw-central"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT data->>'app' AS aplicacion, ROUND((SUM(duration_s)/3600.0)::numeric, 2) AS horas\nFROM event WHERE bucket_id LIKE 'aw-watcher-window%' AND $__timeFilter(start_ts)\nGROUP BY 1 ORDER BY 2 DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        }
      },
      "id": 5
    },
    {
      "type": "barchart",
      "title": "Actividad por PC, de menor a mayor (horas activas)",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "aw-central"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "aw-central"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT d.user_label AS pc, ROUND((COALESCE(SUM(e.duration_s),0)/3600.0)::numeric, 2) AS horas_activas\nFROM device d LEFT JOIN event e ON e.device_id = d.id AND bucket_id LIKE 'aw-watcher-afk%' AND data->>'status' = 'not-afk' AND $__timeFilter(e.start_ts)\nGROUP BY d.user_label ORDER BY 2 ASC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "color": {
            "mode": "continuous-RdYlGr"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        }
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Horas activas por PC y día",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 16,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "aw-central"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "aw-central"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(e.start_ts, '1d'), d.user_label AS metric, SUM(e.duration_s)/3600.0 AS horas\nFROM event e JOIN device d ON d.id = e.device_id\nWHERE bucket_id LIKE 'aw-watcher-afk%' AND data->>'status' = 'not-afk' AND $__timeFilter(e.start_ts)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Dispositivos y última señal",
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "aw-central"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "aw-central"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT user_label AS pc, hostname, tz, last_seen_at AS ultima_senal,\n       EXTRACT(EPOCH FROM (now() - last_seen_at))/60 AS min_sin_reportar\nFROM device ORDER BY last_seen_at DESC NULLS LAST"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "min_sin_reportar"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 15
                    },
                    {
                      "color": "red",
                      "value": 120
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {},
      "id": 8
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Top dominios web (horas)",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "aw-central"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "aw-central"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT data->>'domain' AS dominio, ROUND((SUM(duration_s)/3600.0)::numeric, 2) AS horas\nFROM event WHERE bucket_id LIKE 'aw-watcher-web%' AND data->>'domain' <> '(interno)' AND $__timeFilter(start_ts)\nGROUP BY 1 ORDER BY 2 DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Dominios por PC (horas)",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "aw-central"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "aw-central"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT d.user_label AS pc, e.data->>'domain' AS dominio, ROUND((SUM(e.duration_s)/3600.0)::numeric, 2) AS horas\nFROM event e JOIN device d ON d.id = e.device_id\nWHERE e.bucket_id LIKE 'aw-watcher-web%' AND e.data->>'domain' <> '(interno)' AND $__timeFilter(e.start_ts)\nGROUP BY 1, 2 ORDER BY 3 DESC LIMIT 25"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}